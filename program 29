#include <stdio.h>

int main() {
    int index[20], n, i;

    printf("Enter number of file blocks: ");
    scanf("%d", &n);

    printf("Enter block numbers:\n");

    for (i = 0; i < n; i++)
        scanf("%d", &index[i]);

    printf("\nIndex Block:\n");

    for (i = 0; i < n; i++)
        printf("Index[%d] -> Block %d\n", i, index[i]);

    return 0;
}
