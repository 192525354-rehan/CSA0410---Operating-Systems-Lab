#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>

int main() {
    int fd,n;
    char msg[]="Hello UNIX";
    char buf[20];

    fd=open("file.txt",O_CREAT|O_WRONLY|O_TRUNC,0644);
    write(fd,msg,10);
    close(fd);

    fd=open("file.txt",O_RDONLY);
    n=read(fd,buf,19);
    buf[n]='\0';

    printf("File Content: %s",buf);
    close(fd);

    return 0;
}
