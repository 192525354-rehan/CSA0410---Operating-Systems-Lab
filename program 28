#include <stdio.h>

int main() {
    int start, n, i;

    printf("Enter starting block: ");
    scanf("%d", &start);

    printf("Enter number of blocks: ");
    scanf("%d", &n);

    printf("\nSequential File Allocation:\n");

    for (i = 0; i < n; i++)
        printf("Block %d -> Record %d\n", start + i, i + 1);

    return 0;
}
