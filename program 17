#include <stdio.h>

int main() {
    int alloc[3] = {1, 2, 2};
    int max[3] = {3, 2, 2};
    int avail = 2;
    int need[3];
    int i;

    printf("Allocation  Max  Need\n");

    for(i = 0; i < 3; i++) {
        need[i] = max[i] - alloc[i];
        printf("%5d %7d %6d\n", alloc[i], max[i], need[i]);
    }

    printf("\nAvailable Resources = %d\n", avail);

    for(i = 0; i < 3; i++) {
        if(need[i] <= avail) {
            avail += alloc[i];
            printf("Process P%d Executed\n", i);
        }
    }

    printf("\nSystem is in Safe State.\n");

    return 0;
}
