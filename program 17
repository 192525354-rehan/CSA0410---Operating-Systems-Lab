#include <stdio.h>

int main() {
    int n, m, i, j, k, count = 0, found;
    int a[10][10], mx[10][10], need[10][10], av[10];
    int done[10] = {0}, safe[10];

    scanf("%d%d", &n, &m);

    for(i=0;i<n;i++)
        for(j=0;j<m;j++) scanf("%d",&a[i][j]);

    for(i=0;i<n;i++)
        for(j=0;j<m;j++) scanf("%d",&mx[i][j]);

    for(j=0;j<m;j++) scanf("%d",&av[j]);

    for(i=0;i<n;i++)
        for(j=0;j<m;j++)
            need[i][j] = mx[i][j] - a[i][j];

    while(count<n) {
        found=0;
        for(i=0;i<n;i++) {
            if(!done[i]) {
                for(j=0;j<m;j++)
                    if(need[i][j] > av[j]) break;

                if(j==m) {
                    for(k=0;k<m;k++) av[k] += a[i][k];
                    safe[count++]=i;
                    done[i]=1;
                    found=1;
                }
            }
        }
        if(!found) break;
    }

    if(count==n) {
        printf("Safe State\nSafe Sequence: ");
        for(i=0;i<n;i++) printf("P%d ",safe[i]);
    } else
        printf("Unsafe State");

    return 0;
}
