#include <stdio.h>
#include <stdlib.h>

int main() {
    int request[50], n, head;
    int i, j, temp, total = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter request queue:\n");
    for (i = 0; i < n; i++)
        scanf("%d", &request[i]);

    printf("Enter initial head position: ");
    scanf("%d", &head);

    /* Sort requests */
    for (i = 0; i < n - 1; i++) {
        for (j = i + 1; j < n; j++) {
            if (request[i] > request[j]) {
                temp = request[i];
                request[i] = request[j];
                request[j] = temp;
            }
        }
    }

    printf("\nSeek Sequence:\n");
    printf("%d", head);

    /* Move towards 0 */
    for (i = n - 1; i >= 0; i--) {
        if (request[i] < head) {
            total += abs(head - request[i]);
            head = request[i];
            printf(" -> %d", head);
        }
    }

    /* Move to 0 */
    total += head;
    head = 0;
    printf(" -> 0");

    /* Move in opposite direction */
    for (i = 0; i < n; i++) {
        if (request[i] > head) {
            total += abs(head - request[i]);
            head = request[i];
            printf(" -> %d", head);
        }
    }

    printf("\nTotal Head Movement = %d\n", total);

    return 0;
}
