#include <stdio.h>
#include <stdlib.h>

int main() {
    int r[50], n, head, size, i, j, temp, seek=0;

    printf("Enter number of requests: ");
    scanf("%d",&n);
    printf("Enter requests: ");
    for(i=0;i<n;i++) scanf("%d",&r[i]);

    printf("Enter head and disk size: ");
    scanf("%d%d",&head,&size);

    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(r[i]>r[j]) {
                temp=r[i]; r[i]=r[j]; r[j]=temp;
            }

    printf("Seek Sequence: ");

    for(i=0;i<n;i++)
        if(r[i]>=head) {
            seek += abs(head-r[i]);
            head=r[i];
            printf("%d ",r[i]);
        }

    seek += (size-1)-head;
    head=0;
    seek += size-1;

    for(i=0;i<n;i++)
        if(r[i]<head) {
            seek += abs(head-r[i]);
            head=r[i];
            printf("%d ",r[i]);
        }

    printf("\nTotal Seek Time = %d\n",seek);
    return 0;
}
