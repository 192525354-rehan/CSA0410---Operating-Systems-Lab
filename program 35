#include <stdio.h>

int main() {
    int index, n, b[20], i;

    printf("Enter index block: ");
    scanf("%d",&index);

    printf("Enter number of blocks: ");
    scanf("%d",&n);

    printf("Enter block numbers: ");
    for(i=0;i<n;i++) scanf("%d",&b[i]);

    printf("\nIndex Block = %d\n",index);
    printf("Allocated blocks: ");
    for(i=0;i<n;i++) printf("%d ",b[i]);

    return 0;
}
